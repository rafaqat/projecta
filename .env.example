# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=database
# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_DATABASE=app

# Environment: local | test | uat | production
APP_ENV=local

# Identity
OIDC_ISSUER=http://127.0.0.1:9000
OIDC_ALLOWED_ISSUERS=http://127.0.0.1:9000

# LLM gateway (the only route to a model provider)
ANTHROPIC_BASE_URL=http://127.0.0.1:4318
LLM_GATEWAY_TOKEN=local-dev-token
# Your Anthropic Messages API key (sk-ant-api...): the gateway uses it to call Claude.
# Leave blank to run against the local provider-stub; set it for live answers.
ANTHROPIC_API_KEY=

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
APP_NAME=code-intelligence-assistant
APP_VERSION=0.0.1
# Host port published for the Compose Postgres; change if 5432 is in use locally
# POSTGRES_HOST_PORT=5432
OIDC_CLIENT_ID=code-intelligence-assistant
OIDC_CLIENT_SECRET=local-dev-client-secret
# Comma-separated Entra tenant IDs (tid) permitted to sign in
OIDC_ALLOWED_TENANTS=tenant-local
# Local identity provider used by the Compose stack: the mock (default) or
# Keycloak (`make up PROFILES=test,keycloak`, then sign in as developer/developer).
# OIDC_ISSUER_LOCAL=http://keycloak:8080/realms/cia

# Git hosts repositories may be registered from (comma-separated host[:port])
GIT_ALLOWED_HOSTS=github.com

# Package registries Tier 1/3 dependency fetches may contact (ADR-009, SEC-04): https:// origins only,
# comma-separated; lockfile `resolved` URLs are never followed. Empty disables dependency fetches.
DEPENDENCY_REGISTRIES=https://registry.npmjs.org

# Clone detection: matches below this many normalised tokens are repeated patterns, not duplicates (design §7)
CLONE_MIN_TOKENS=50

# Audit chain signing seed (32 bytes hex). Local development value; Key Vault on Azure (ADR-025).
AUDIT_SIGNING_SEED=0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0

# Gateway policy signing (ADR-024). Local dev seed and its public key; the release workflow signs elsewhere.
GATEWAY_POLICY_SEED=1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f809
GATEWAY_POLICY_PUBLIC_KEY={"crv":"Ed25519","x":"Bpq6h3R92cH0byQATreeBeuPLg8sOt_d5gweLgC6yDg","kty":"OKP"}
HONEYTOKEN_HMAC_KEY=local-honeytoken-key
# Share of turns carrying a compliance canary (ADR-069): one synthetic evidence block asking the
# assistant to append a token, so how often the model follows an instruction in its evidence is
# measured on real traffic. Unset is off. README explains it to the people it runs on.
CANARY_SAMPLE_RATE=0.02
# Injection classifier pinned in models.lock.json (ADR-037); a boot guard refuses an unset value outside local.
INJECTION_DETECTOR_MODEL=protectai/deberta-v3-base-prompt-injection-v2
# Provider cost reconciliation (ADR-038): held by services/cost-reconciler alone; leave empty locally.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_WORKSPACE_ID=

# ADR-040: the model server (services/model-server, `make model-server`) serves the embedder and the
# injection classifier on the host's GPU. Unset: both run in-process on CPU.
# MODEL_SERVER_URL=http://host.docker.internal:8765
