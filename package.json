    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "canonicalize": "^5.0.0",
    "class-variance-authority": "0.7.1",
