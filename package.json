{
  "name": "projecta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node serve.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node test.js",
    "typecheck": "tsc --noEmit",
    "models": "node scripts/fetch-models.mjs",
    "evals": "node evals/harness/run.ts",
    "test:evals": "node --test evals/harness/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "imports": {
    "#app/*": "./app/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#guards/*": "./packages/guards/src/*.js",
    "#cost/*": "./packages/cost/src/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
