event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" The payment flow starts in the orders route, which validates the request body, reserves inventory for every line item, and only then creates a payment intent."}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" On failure the reservation is released and the caller receives a 402 with a stable error code so clients can retry safely without double charging the customer."}}

event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" Refund requests follow the same shape: the service looks up the original intent, asks the provider to reverse it, and records the outcome in the audit log."}}

