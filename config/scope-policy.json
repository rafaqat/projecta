  "templates": {
    "outOfScope": "This assistant only answers questions about {repository} at {commit}, using evidence from its code.",
    "absence": "No evidence was found in the indexed files for this question.",
    "notFound": "No symbol named `{identifier}` exists at {commit}.",
    "decline": "Part of this request is outside what this assistant answers.",
    "withheld": "Part of this answer was withheld because it went beyond what the cited code shows.",
    "error": "The answer could not be checked against the repository evidence and was withheld.",
    "noInstance": "The code of {repository} at {commit} that was retrieved and searched does not use this. What was examined is listed below."
