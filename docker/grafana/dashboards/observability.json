    {
      "id": 20,
      "type": "table",
      "title": "Unhandled errors: code, cause and status (click trace_id for the trace)",
      "description": "The log body of a security event is its name, so the readable part is in the labels. app_error_code names the error class, app_error_cause the errno underneath it (EAI_AGAIN, ECONNREFUSED); both are closed sets, which is why they survive redaction where the message does not.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"projectA\"} | app_security_event=\"error.unhandled\"",
          "queryType": "range"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "keepTime": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Time|app_error_code|app_error_cause|http_response_status_code|app_request_id|trace_id)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "Time": 0,
              "app_error_code": 1,
              "app_error_cause": 2,
              "http_response_status_code": 3,
              "app_request_id": 4,
              "trace_id": 5
            },
            "renameByName": {
              "app_error_code": "error code",
              "app_error_cause": "cause (errno)",
              "http_response_status_code": "status",
              "app_request_id": "request id",
              "trace_id": "trace"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Security events per minute, by event",
      "gridPos": {
