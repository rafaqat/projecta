    {
      "id": 8,
      "type": "table",
      "title": "Traces with errors: what failed (Tempo)",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ status = error } | select(statusMessage, span.server.address, span.app.error.code)",
          "limit": 20,
          "tableType": "spans"
        }
      ],
      "options": {},
      "description": "statusMessage is a span intrinsic, so it survives the collector's attribute allowlist (SEC-14) and can be read here. The row names the failure; the trace is for the sequence that led to it.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "statusMessage"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 340
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trace Name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          }
        ]
      }
    },
