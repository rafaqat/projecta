            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (app_security_event) (count_over_time({service_name=\"projectA\"} | app_security_event != \"\" [1m]))",
          "queryType": "range",
          "legendFormat": "{{app_security_event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
